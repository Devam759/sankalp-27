rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Roles collection rules
    match /roles/{uid} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Registrations collection
    match /registrations/{id} {
      allow read: if true;
      allow create: if false; // Admin SDK creates registrations server-side
      allow update, delete: if request.auth != null;
    }

    // Pending Registrations collection
    match /pendingRegistrations/{id} {
      allow read, write: if false; // Only Admin SDK can read/write
    }

    // Notifications/Announcements collections
    match /notifications/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /announcements/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Scan logs collection
    match /scanLogs/{id} {
      allow read, write: if true;
    }

    // Events (public schedule)
    match /events/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Audit logs collection
    match /auditLogs/{id} {
      allow read, create, update, delete: if true;
    }

    // Settings
    match /settings/{id} {
      allow read, write: if true;
    }

    // Scanner Accounts collection
    match /scannerAccounts/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Coupons collection
    match /coupons/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Paper Submissions collection
    match /paperSubmissions/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Contact Messages collection
    match /contact_messages/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
