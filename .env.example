# ==============================================================================
# SANKALP 2027 ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in your actual project credentials.
# WARNING: NEVER COMMIT .env.local TO GITHUB!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CONFIGURATION (Client-side Public Variables)
# Get these from: Firebase Console -> Project Settings -> General -> Your Apps -> Web App
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="your_api_key_here"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="conference-portal.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="conference-portal"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="conference-portal.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your_measurement_id"

# ------------------------------------------------------------------------------
# GOOGLE RECAPTCHA V3 CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6LcnfYAtAAAAANwsn9-4TPzCpIPHLfQ2Mq-C5LQk"
RECAPTCHA_SECRET_KEY="your_recaptcha_secret_key"

# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN SERVICE ACCOUNT (Optional for server-side operations)
# Either place service-account.json in root or paste base64 encoded JSON here
# ------------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=""

# ------------------------------------------------------------------------------
# 3. CASHFREE PAYMENT GATEWAY
# Get these from your Cashfree Merchant Dashboard
# ------------------------------------------------------------------------------
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_PROD_APP_ID="your_production_app_id"
CASHFREE_PROD_SECRET_KEY="your_production_secret_key"
CASHFREE_TEST_APP_ID="your_sandbox_app_id"
CASHFREE_TEST_SECRET_KEY="your_sandbox_secret_key"
NEXT_PUBLIC_CASHFREE_ENV="PRODUCTION" # Set to "PRODUCTION" or "SANDBOX"

# ------------------------------------------------------------------------------
# 4. FIREBASE / SMTP EMAIL CONFIGURATION (Nodemailer)
# Used for sending registration confirmation emails, PDF receipts, and admin alerts
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"             # Firebase / Google Workspace / Custom SMTP server
SMTP_PORT="587"                        # 587 for STARTTLS, 465 for SSL/TLS
SMTP_SECURE="false"                    # true for port 465, false for port 587
SMTP_USER="sankalp@jklu.edu.in"        # SMTP sender email address
SMTP_PASS="your_email_app_password"    # SMTP password / App Password
SMTP_FROM="SANKALP 2027 Secretariat <sankalp@jklu.edu.in>"

# ------------------------------------------------------------------------------
# 5. CLOUDINARY MEDIA STORAGE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="flufexsc"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

